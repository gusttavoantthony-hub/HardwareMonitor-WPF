<Window x:Class="HardwareHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:HardwareHub.UI.ViewModels"
        mc:Ignorable="d"
        Title="Hardware Hub - Monitor de Sistema" Height="450" Width="800"
        Background="#FF121212" Foreground="White" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="HARDWARE &amp; SYSTEM HUB" FontSize="22" FontWeight="Bold" Foreground="#FF00E676" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Cards de Informações -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="10">
            <!-- Card CPU -->
            <Border Background="#FF1E1E1E" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Uso da CPU" FontSize="16" Foreground="#FFB0BEC5" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1} %}" FontSize="36" FontWeight="Bold" Foreground="#FF00E676" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card Memória -->
            <Border Background="#FF1E1E1E" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Memória Disponível" FontSize="16" Foreground="#FFB0BEC5" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AvailableMemory, StringFormat={}{0:F0} MB}" FontSize="36" FontWeight="Bold" Foreground="#FF29B6F6" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Rodapé com Status -->
        <StatusBar Grid.Row="2" Background="Transparent" Foreground="#FF9E9E9E">
            <StatusBarItem Content="{Binding StatusText}"/>
        </StatusBar>
    </Grid>
</Window>